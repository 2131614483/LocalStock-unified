{
  "name": "localstock-desktop",
  "version": "0.2.0",
  "description": "LocalStock 桌面便携版 - 本地 A 股行情工具（同花顺风格，免登录，SQLite）",
  "main": "./out/main/index.js",
  "author": "Open Dev Society",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-icon": "node scripts/generate-icon.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win portable",
    "build:all": "npm run typecheck && npm run build:win"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^11.10.0",
    "echarts": "^5.6.0",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  }
}
